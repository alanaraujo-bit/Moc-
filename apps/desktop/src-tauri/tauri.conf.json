{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mocó",
  "mainBinaryName": "moco",
  "version": "0.2.0",
  "identifier": "app.moco.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mocó",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Mocó",
    "copyright": "© 2026 Mocó",
    "category": "Utility",
    "shortDescription": "Seu cantinho seguro para senhas e tudo que importa.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false,
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true,
    "longDescription": "Mocó guarda senhas, documentos, cartões e tudo que importa, cifrado no seu computador com uma chave que só você tem."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0N0UxMDQwRjIzMjFDNkMKUldSc0hETHlRQkIrbEJTSFJ0ZHNtVy9hN3BkdHY0M2tvMSs3em0xazd2OFBGOXRiMzJtRys2NDUK",
      "endpoints": [
        "https://github.com/alanaraujo-bit/Moc-/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
